{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.8.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.4",
    "recharts": "^3.8.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "audit:api": "node scripts/audit-api.cjs",
    "test:coverage": "react-scripts test --watchAll=false --runInBand --silent --coverage --collectCoverageFrom=src/pages/**/*.jsx --collectCoverageFrom=src/components/**/*.jsx --collectCoverageFrom=src/App.js --coverageReporters=json-summary --coverageReporters=lcov --coverageReporters=text-summary --json --outputFile=test-results.json",
    "start:integration": "node scripts/start-integration.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^13.5.0",
    "ajv": "^8.20.0",
    "react-scripts": "5.0.1"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  }
}
