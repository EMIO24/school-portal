# Backend API base URL (no trailing slash)
# Local dev:  http://localhost:8000
# Production: https://your-backend.up.railway.app
REACT_APP_API_URL=http://localhost:8000

# Paystack public key (starts with pk_live_ or pk_test_)
REACT_APP_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# School subdomain slug — required when the frontend and backend are on
# different domains (e.g. Cloudflare Pages + Railway). The frontend sends
# this as the X-School-Slug header so the backend can resolve the tenant.
# Leave empty for subdomain-based local dev.
REACT_APP_SCHOOL_SLUG=greenfield
