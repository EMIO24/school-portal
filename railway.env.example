# ============================================================
# RAILWAY ENVIRONMENT VARIABLES
# ============================================================
# Copy this file, fill in real values, then import into Railway:
#   railway variables --set "$(cat railway.env)"
# OR paste each variable manually in:
#   Railway dashboard → your service → Variables tab
#
# Create THREE services in one Railway project:
#   1. web    — backend/Dockerfile, entrypoint.sh (gunicorn)
#   2. worker — same image, start command: celery -A config worker --loglevel=info --concurrency=2
#   3. beat   — same image, start command: celery -A config beat  --loglevel=info --scheduler django_celery_beat.schedulers:DatabaseScheduler
#
# Add the PostgreSQL plugin → DATABASE_URL is auto-injected into all services.
# ============================================================


# ── Django ────────────────────────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DJANGO_SETTINGS_MODULE=config.settings.production

# Comma-separated. Always include your Railway web URL.
# Example: your-app.up.railway.app,api.yourschool.ng
ALLOWED_HOSTS=your-app.up.railway.app


# ── Database ──────────────────────────────────────────────────────────────
# AUTO-INJECTED by Railway PostgreSQL plugin — do NOT set manually.
# DATABASE_URL=postgresql://...


# ── Redis (Upstash) ───────────────────────────────────────────────────────
# Get from: https://console.upstash.com → your database → REST API → .env
# Must start with rediss:// (TLS) for Upstash.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379


# ── Email (Brevo) ────────────────────────────────────────────────────────
# Get from: https://app.brevo.com → Account → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address on all outgoing emails. Must be a verified Brevo sender.
DEFAULT_FROM_EMAIL=noreply@yourschool.ng


# ── Superadmin (created automatically on first deploy via entrypoint.sh) ──
DJANGO_SUPERUSER_EMAIL=admin@yourschool.ng
DJANGO_SUPERUSER_PASSWORD=change-me-after-first-login


# ── Paystack ─────────────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here


# ── Termii SMS ───────────────────────────────────────────────────────────
# Get from: https://termii.com → Settings → API Keys
TERMII_API_KEY=TLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Cloudinary (media uploads) ────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── CORS — Cloudflare Pages frontend ─────────────────────────────────────
# Your Cloudflare Pages URL (no trailing slash). Both the production URL
# and *.pages.dev preview URLs are already allowed by the CORS regex;
# this var is for exact-match if you use a custom domain.
FRONTEND_URL=https://your-school-portal.pages.dev


# ── Gunicorn tuning (optional) ────────────────────────────────────────────
# Default is 2. Increase if your Railway plan has more RAM (each worker ~80MB).
GUNICORN_WORKERS=2
