# Set values in the deployment secret manager; never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
PLATFORM_MFA_KEY=REPLACE_WITH_UNIQUE_FERNET_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@HOST:6379/0
ALLOWED_HOSTS=api.your-domain.example
FRONTEND_URL=https://portal.your-domain.example
CORS_ALLOWED_ORIGINS=https://portal.your-domain.example
PAYSTACK_MODE=live
PAYSTACK_SECRET_KEY=REPLACE_WITH_PAYSTACK_LIVE_SECRET
TERMII_API_KEY=REPLACE_WITH_TERMII_KEY
BREVO_API_KEY=REPLACE_WITH_BREVO_KEY
DEFAULT_FROM_EMAIL=notifications@your-domain.example
RUN_MIGRATIONS=true
# Staging only: PAYSTACK_MODE=test and DEPLOYMENT_CHECK_ARGS=--allow-test-payments
# Worker command: celery -A config worker --loglevel=info
# Scheduler command: celery -A config beat --loglevel=info
# Worker/scheduler services: RUN_MIGRATIONS=false (exactly one beat instance).
