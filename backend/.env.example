# ── Django Core ────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.up.railway.app

# Django settings module — use production on Railway, local for dev
DJANGO_SETTINGS_MODULE=config.settings.local

# ── Database ───────────────────────────────────────────────────────────────
# Auto-injected by Railway PostgreSQL add-on. For local dev, use docker-compose.
DATABASE_URL=postgres://user:password@localhost:5432/school_portal

# Local dev overrides (used by docker-compose)
POSTGRES_DB=school_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost

# ── Cache / Celery (Upstash Redis) ─────────────────────────────────────────
# For local dev: redis://localhost:6379/0
# For Upstash (production): rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ── Email (Brevo) ──────────────────────────────────────────────────────────
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=noreply@yourschool.ng

# ── Superadmin (auto-created on first deploy) ─────────────────────────────
DJANGO_SUPERUSER_EMAIL=admin@yourschool.ng
DJANGO_SUPERUSER_PASSWORD=change-me-immediately

# ── Paystack ───────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# ── Termii SMS ─────────────────────────────────────────────────────────────
TERMII_API_KEY=TLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudinary (media uploads) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend (CORS) ────────────────────────────────────────────────────────
# Your Cloudflare Pages URL (no trailing slash)
FRONTEND_URL=https://your-school-portal.pages.dev
